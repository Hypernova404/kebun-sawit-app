
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model Kebun {
  id         String     @id @default(cuid())
  userId     String
  nama       String
  lokasi     String?
  wilayah    String     @default("Kalimantan Barat")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  afdelingen Afdeling[]
  bloks      Blok[]

  @@index([userId])
}

model Afdeling {
  id      String  @id @default(cuid())
  kebunId String
  kode    String
  nama    String?
  luasHa  Float
  kebun   Kebun   @relation(fields: [kebunId], references: [id], onDelete: Cascade)
  bloks   Blok[]

  @@unique([kebunId, kode])
}

model Blok {
  id            String             @id @default(cuid())
  afdelingId    String
  kebunId       String
  kode          String
  luasHa        Float
  tahunTanam    Int
  jumlahPokok   Int                @default(0)
  varietas      String?
  jenisLahan    String             @default("mineral")
  dosisOverride String?
  afdeling      Afdeling           @relation(fields: [afdelingId], references: [id], onDelete: Cascade)
  kebun         Kebun              @relation(fields: [kebunId], references: [id], onDelete: Cascade)
  riwayats      RiwayatKalkulasi[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([kebunId, kode])
}

model RiwayatKalkulasi {
  id        String   @id @default(cuid())
  userId    String
  jenisMenu String
  tanggal   DateTime @default(now())
  dataInput String
  dataHasil String
  blokId    String?
  blok      Blok?    @relation(fields: [blokId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([jenisMenu, tanggal])
}

model User {
  id            String             @id
  name          String
  email         String
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  kebuns        Kebun[]
  riwayats      RiwayatKalkulasi[]

  @@unique([email])
  @@map("user")
}
