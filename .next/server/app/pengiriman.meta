{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/pengiriman/layout,_N_T_/pengiriman/page,_N_T_/pengiriman"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/pengiriman/__PAGE__",
    "/pengiriman",
    "/_index",
    "/_head"
  ]
}